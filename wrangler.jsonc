{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tgpu-teman",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "main": "./worker/entry.ts"
}
